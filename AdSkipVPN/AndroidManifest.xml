<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.adskip.vpn"
    android:versionCode="100"
    android:versionName="1.0.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <!-- fake-VPN 需建 tun 与上游 UDP 通信；与无 INTERNET 的 manager App 完全分离 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 8+ foreground service 必需 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API>=31：specialUse 前台服务类型所需权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 开机 / 应用更新后自启（仅当用户已启用时才启动服务） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AdSkipVpnApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_vpn_notify"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdSkip.NoActionBar">

        <!-- LAUNCHER/MAIN：供 manager App deep-link 按包名启动（T9） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 核心 VpnService：DNS-only 分流隧道 + 本地 DNS 代理 -->
        <service
            android:name=".AdSkipVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="AdSkip DNS filtering VPN service" />
        </service>

        <!-- 开机 / 应用更新自启 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
